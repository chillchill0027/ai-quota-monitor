<Window x:Class="AIQuotaMonitor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:AIQuotaMonitor.Controls"
 Title="AI 额度看板" Width="390" SizeToContent="Height" MaxHeight="900"
 WindowStyle="None" AllowsTransparency="False" Background="Transparent"
 Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
 ShowInTaskbar="True" Topmost="False" ResizeMode="NoResize" UseLayoutRounding="True">
 <Border x:Name="DashboardSurface" CornerRadius="24" Padding="16">
  <StackPanel>
   <Grid x:Name="HeaderBar" Height="28" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" ToolTip="拖动以移动窗口；右键查看窗口操作">
    <Grid.ContextMenu><ContextMenu><MenuItem Header="收起到托盘" Click="OnHideClick"/><MenuItem Header="最小化" Click="OnMinimizeClick"/><Separator/><MenuItem Header="退出应用" Click="OnExitClick"/></ContextMenu></Grid.ContextMenu>
    <TextBlock x:Name="HeaderTitle" Text="AI 额度" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="RefreshAllBtn" Style="{StaticResource GlassButton}" Height="26" Width="88" Padding="8,4" Click="OnRefreshAllClick" AutomationProperties.Name="全部刷新" Margin="0,0,8,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="RefreshGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="RefreshLabel" Text="全部刷新" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="SettingsBtn" Style="{StaticResource GlassButton}" Width="28" Height="28" Padding="0" Click="OnSettingsToggleClick" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock x:Name="SettingsGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="12"/></Button>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="StatusBannerText" Visibility="Collapsed"/>
   <ScrollViewer x:Name="CardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="CardsContainer"><Border x:Name="DeepSeekCard" Style="{StaticResource ProviderCard}">
 <StackPanel><Grid Height="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Button Style="{StaticResource ProviderHeading}" Tag="DeepSeek" Click="OnProviderMenuClick" AutomationProperties.Name="DeepSeek菜单" ToolTip="DeepSeek：刷新、用量页与设置"><StackPanel Orientation="Horizontal"><Image Source="Resources/ProviderIcons/deepseek.png" Width="21" Height="21" Stretch="Uniform"/><TextBlock Text="DeepSeek" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
 <controls:StatusBadge x:Name="DeepSeekStatus" Grid.Column="1" VerticalAlignment="Center"/></Grid>
 <TextBlock x:Name="DeepSeekAmount" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" Typography.NumeralAlignment="Tabular"/></StackPanel></Border>
<Border x:Name="MiMoCard" Style="{StaticResource ProviderCard}">
 <StackPanel><Grid Height="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Button Style="{StaticResource ProviderHeading}" Tag="MiMo" Click="OnProviderMenuClick" AutomationProperties.Name="小米 MiMo菜单" ToolTip="小米 MiMo：刷新、用量页与设置"><StackPanel Orientation="Horizontal"><Image Source="Resources/ProviderIcons/mimo.png" Width="21" Height="21" Stretch="Uniform"/><TextBlock Text="小米 MiMo" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
 <controls:StatusBadge x:Name="MiMoStatus" Grid.Column="1" VerticalAlignment="Center"/></Grid>
 <TextBlock x:Name="MiMoAmount" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" Typography.NumeralAlignment="Tabular"/></StackPanel></Border>
<Border x:Name="CodexCard" Style="{StaticResource ProviderCard}">
 <StackPanel><Grid Height="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Button Style="{StaticResource ProviderHeading}" Tag="ChatGPT" Click="OnProviderMenuClick" AutomationProperties.Name="OpenAI · Codex菜单" ToolTip="OpenAI · Codex：刷新、用量页与设置"><StackPanel Orientation="Horizontal"><Border Width="21" Height="21" Background="{DynamicResource PrimaryTextBrush}"><Border.OpacityMask><ImageBrush ImageSource="Resources/ProviderIcons/openai.png" Stretch="Uniform"/></Border.OpacityMask></Border><TextBlock Text="OpenAI · Codex" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
 <controls:StatusBadge x:Name="CodexStatus" Grid.Column="1" VerticalAlignment="Center"/></Grid>
 <StackPanel Margin="0,10,0,0"><controls:QuotaBarRow x:Name="Codex5hRow" Label="5 小时" Tint="{DynamicResource PrimaryTextBrush}"/>
<controls:QuotaBarRow x:Name="Codex7dRow" Label="7 天" Tint="{DynamicResource PrimaryTextBrush}" Margin="0,8,0,0"/></StackPanel></StackPanel></Border>
<Border x:Name="GeminiCard" Style="{StaticResource ProviderCard}">
 <StackPanel><Grid Height="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Button Style="{StaticResource ProviderHeading}" Tag="Gemini" Click="OnProviderMenuClick" AutomationProperties.Name="Gemini菜单" ToolTip="Gemini：刷新、用量页与设置"><StackPanel Orientation="Horizontal"><Image Source="Resources/ProviderIcons/gemini.png" Width="21" Height="21" Stretch="Uniform"/><TextBlock Text="Gemini" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
 <controls:StatusBadge x:Name="GeminiStatus" Grid.Column="1" VerticalAlignment="Center"/></Grid>
 <StackPanel Margin="0,10,0,0"><controls:QuotaBarRow x:Name="Gemini5hRow" Label="5 小时" Tint="{DynamicResource AccentBrush}"/>
<controls:QuotaBarRow x:Name="Gemini7dRow" Label="7 天" Tint="{DynamicResource AccentBrush}" Margin="0,8,0,0"/></StackPanel></StackPanel></Border>
<Border x:Name="AntigravityCard" Style="{StaticResource ProviderCard}" Margin="0">
 <StackPanel><Grid Height="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Button Style="{StaticResource ProviderHeading}" Tag="Antigravity" Click="OnProviderMenuClick" AutomationProperties.Name="Antigravity菜单" ToolTip="Antigravity：刷新、用量页与设置"><StackPanel Orientation="Horizontal"><Image Source="Resources/ProviderIcons/antigravity.png" Width="21" Height="21" Stretch="Uniform"/><TextBlock Text="Antigravity" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
 <controls:StatusBadge x:Name="AntigravityStatus" Grid.Column="1" VerticalAlignment="Center"/></Grid>
 <StackPanel Margin="0,10,0,0"><controls:QuotaBarRow x:Name="Agy5hRow" Label="Gemini · 5 小时" Tint="{DynamicResource AccentBrush}"/>
<controls:QuotaBarRow x:Name="AgyWeeklyRow" Label="Gemini · 7 天" Tint="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
<controls:QuotaBarRow x:Name="AgyArgonRow" Label="Argon · 7 天" Tint="{DynamicResource AccentBrush}" Margin="0,8,0,0"/></StackPanel></StackPanel></Border></StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="SettingsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border x:Name="SettingsPanel" Style="{StaticResource ProviderCard}" Padding="16" Margin="0">
     <StackPanel>
      <TextBlock Text="显示供应商" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal"><ToggleButton x:Name="CbDeepSeek" Tag="DeepSeek" Style="{StaticResource ProviderToggle}" Click="OnProviderToggle" ToolTip="DeepSeek" AutomationProperties.Name="DeepSeek"><Image Source="Resources/ProviderIcons/deepseek.png" Width="28" Height="28" Stretch="Uniform"/></ToggleButton>
<ToggleButton x:Name="CbMiMo" Tag="MiMo" Style="{StaticResource ProviderToggle}" Click="OnProviderToggle" ToolTip="小米 MiMo" AutomationProperties.Name="小米 MiMo" Margin="12,0,0,0"><Image Source="Resources/ProviderIcons/mimo.png" Width="28" Height="28" Stretch="Uniform"/></ToggleButton>
<ToggleButton x:Name="CbCodex" Tag="ChatGPT" Style="{StaticResource ProviderToggle}" Click="OnProviderToggle" ToolTip="OpenAI · Codex" AutomationProperties.Name="OpenAI · Codex" Margin="12,0,0,0"><Border Width="28" Height="28" Background="{DynamicResource PrimaryTextBrush}"><Border.OpacityMask><ImageBrush ImageSource="Resources/ProviderIcons/openai.png" Stretch="Uniform"/></Border.OpacityMask></Border></ToggleButton>
<ToggleButton x:Name="CbGemini" Tag="Gemini" Style="{StaticResource ProviderToggle}" Click="OnProviderToggle" ToolTip="Gemini" AutomationProperties.Name="Gemini" Margin="12,0,0,0"><Image Source="Resources/ProviderIcons/gemini.png" Width="28" Height="28" Stretch="Uniform"/></ToggleButton>
<ToggleButton x:Name="CbAntigravity" Tag="Antigravity" Style="{StaticResource ProviderToggle}" Click="OnProviderToggle" ToolTip="Antigravity" AutomationProperties.Name="Antigravity" Margin="12,0,0,0"><Image Source="Resources/ProviderIcons/antigravity.png" Width="28" Height="28" Stretch="Uniform"/></ToggleButton></StackPanel>
      <Separator Margin="0,20,0,20"/>
      <Button Style="{StaticResource ProviderHeading}" Click="OnExitClick" HorizontalAlignment="Left" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.Name="退出应用"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="退出应用" FontSize="12" FontWeight="Medium"/></StackPanel></Button>
     </StackPanel>
    </Border>
   </ScrollViewer>
  </StackPanel>
 </Border>
</Window>
