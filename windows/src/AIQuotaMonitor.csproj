<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources/AppIcon.ico</ApplicationIcon>
    <AssemblyName>AIQuotaMonitor</AssemblyName>
    <RootNamespace>AIQuotaMonitor</RootNamespace>
    <Version>1.4.4</Version>
    <Authors>chillchill0027</Authors>
    <Company>AI Quota Monitor</Company>
    <Product>AI 额度看板</Product>
    <Description>集中查看 DeepSeek、小米 MiMo、OpenAI Codex、Gemini 和 Antigravity 的余额或剩余额度 (Windows 版)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources/AppIcon.png" />
    <Resource Include="Resources/AppIcon.ico" />
    <Resource Include="Resources/ProviderIcons/*.png" />
    <None Include="../../Resources/ThirdPartyNotices.txt" Link="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
