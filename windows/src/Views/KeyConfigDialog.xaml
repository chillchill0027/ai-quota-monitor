<Window x:Class="AIQuotaMonitor.Views.KeyConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek API Key 设置"
        Width="380"
        Height="210"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Border CornerRadius="14" Background="#282828" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Text="配置 DeepSeek API Key" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
            <TextBlock Text="Key 将使用 Windows DPAPI 加密存入当前 Windows 账户安全存储中：" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBox x:Name="KeyInputBox" Height="30" FontSize="12" Background="#181818" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" Padding="6,4" Margin="0,0,0,16" />

            <DockPanel LastChildFill="False">
                <Button Content="清除 Key" Click="OnClearClick" Background="#30FF5555" Foreground="#FF8888" BorderThickness="0" Padding="12,5" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="取消" Click="OnCancelClick" Background="#20FFFFFF" Foreground="#CCCCCC" BorderThickness="0" Padding="12,5" Margin="0,0,8,0" />
                    <Button Content="保存并查询" Click="OnSaveClick" Background="#0078D4" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="14,5" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
