<Application x:Class="AIQuotaMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Modern Windows 11 Dark/Light Theme Brushes -->
        <SolidColorBrush x:Key="CardBackground" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F0FFFFFF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="AccentColor" Color="#0078D4" />
    </Application.Resources>
</Application>
